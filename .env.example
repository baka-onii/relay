# Set these in the environment before starting relay.
# This file is documentation; it is not automatically loaded.
# Optional explicit settings file (no automatic workspace config discovery):
# RELAY_CONFIG=relay.toml
RELAY_WORKSPACE=examples/workspace
# RELAY_LLM_PROVIDER=openai # or "anthropic" for Anthropic-styled endpoints
RELAY_LLM_BASE_URL=http://127.0.0.1:8080
RELAY_LLM_MODEL=ornith
# Optional provider authentication (keep real values out of Git):
# RELAY_LLM_API_KEY=
# Browser users can alternatively paste their own session-only key in Settings
# (API key field) to use hosted OpenAI-compatible providers without touching
# the server environment. Session keys are never stored.
# Optional offline Needle library / custom weights:
# NEEDLE_LIB_PATH=/absolute/path/to/libneedle.so
# NEEDLE_WEIGHTS=/absolute/path/to/model.cact
NEEDLE_TELEMETRY=0
# Browser session backup (SQLite). Defaults to ~/.relay/sessions.db.
# Conversations persist across restarts; per-token traces are never stored.
# RELAY_SESSIONS_DB=/absolute/path/to/sessions.db
